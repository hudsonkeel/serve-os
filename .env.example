# ─── Supabase ─────────────────────────────────────────────────────────────────
# Required. Found in Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend (email notifications) ────────────────────────────────────────────
# Required for email notifications. Found in Resend dashboard → API Keys.
RESEND_API_KEY=

# ─── Notification routing ─────────────────────────────────────────────────────
# Sender address shown in email From field.
SERVE_NOTIFICATION_FROM="Serve OS <alerts@servecaregiving.com>"

# Optional. If set, notification emails will have this as the Reply-To address.
SERVE_NOTIFICATION_REPLY_TO=

# Base URL of this app in production. Used for "View in Serve OS →" links in emails.
SERVE_APP_URL=https://os-servecaregiving.netlify.app

# Comma-separated email addresses to notify on new caregiver recruiting leads.
SERVE_NOTIFY_RECRUITING=

# Comma-separated email addresses to notify on new Managing Director recruiting leads.
SERVE_NOTIFY_LEADERSHIP=

# Comma-separated email addresses to notify on new care prospect submissions.
# Note: prospect notification rules are typed but not yet wired. Set now for when they go live.
SERVE_NOTIFY_CARE_PROSPECTS=

# ─── Apploi ──────────────────────────────────────────────────────────────────
# Caregiver application redirect URL. If not set, the Apploi button will not appear.
NEXT_PUBLIC_APPLOI_CAREGIVER_URL=

# ─── Serve Workflow Links ──────────────────────────────────────────────
NEXT_PUBLIC_CINCH_CCM_URL=
NEXT_PUBLIC_AXISCARE_URL=
NEXT_PUBLIC_APPLOI_URL=
NEXT_PUBLIC_VIVENTIUM_URL=
NEXT_PUBLIC_SERVE_INTAKE_URL=
NEXT_PUBLIC_DIALPAD_URL=
NEXT_PUBLIC_GMAIL_URL=

# AxisCare — read-only discovery integration (lib/integrations/axiscare/).
# AXISCARE_API_BASE_URL must be the bare server origin, no /api suffix —
# every endpoint path already includes /api (e.g. /api/visits), so a base
# URL ending in /api would double it. Site number is embedded in the
# hostname, e.g.:
#   AXISCARE_API_BASE_URL=https://16282.axiscare.com
AXISCARE_API_TOKEN=
AXISCARE_SITE_NUMBER=
AXISCARE_API_VERSION=
AXISCARE_API_BASE_URL=

# Release control for Workspace's live AxisCare schedule feature —
# independent of the credentials above (leaving this unset/false disables
# the feature even if AxisCare credentials are fully configured). Server-
# only: no NEXT_PUBLIC_ prefix, never read by browser code. Only the exact
# value "true" enables the feature; missing, empty, "false", or any other
# value (including "TRUE"/"True") is treated as disabled. Do not rely on
# removing the token as the normal way to turn this feature off — use this
# flag; revoking the token is an emergency/last-resort measure, not a
# routine one. Default: unset (disabled). Production must remain disabled
# until Hud explicitly approves enabling it.
AXISCARE_SCHEDULE_ENABLED=

